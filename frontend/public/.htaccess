<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Clean API paths -> PHP endpoints
  RewriteRule ^api/applications$ api/applications.php [L]
  RewriteRule ^api/game/score$ api/game/score.php [L]
  RewriteRule ^api/admin/game-scores$ api/admin/game_scores.php [L]
  RewriteRule ^api/auth/login$ api/admin/login.php [L]
  RewriteRule ^api/auth/me$ api/admin/me.php [L]
  RewriteRule ^api/auth/logout$ api/admin/logout.php [L]
  RewriteRule ^api/admin/applications/export$ api/admin/export.php [L]
  RewriteRule ^api/admin/applications$ api/admin/applications.php [L]
  RewriteRule ^api/admin/blogs-order$ api/admin/blogs.php?action=order [QSA,L]
  RewriteRule ^api/admin/blogs/?$ api/admin/blogs.php [L]
  RewriteRule ^api/admin/blogs/([^/]+)$ api/admin/blogs.php?id=$1 [QSA,L]
  RewriteRule ^api/admin/upload$ api/admin/upload.php [L]
  RewriteRule ^api/blogs/?$ api/blogs.php [L]
  RewriteRule ^api/blogs/([^/]+)$ api/blogs.php?slug=$1 [QSA,L]
  RewriteRule ^api/uploads/([^/]+)$ api/uploads.php?id=$1 [QSA,L]

  # Serve real files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback for React Router (/admin, /gamingzone, /legal/...)
  RewriteRule ^ index.html [L]
</IfModule>
